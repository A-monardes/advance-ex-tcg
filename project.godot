; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Advance EX TCG"
config/use_custom_user_dir=true
config/custom_user_dir_name="EX TCG Retro"
config/description="Simulador estilo GBA del Pokémon TCG, era EX (2003-2007)"
run/main_scene="res://scenes/duel.tscn"
config/features=PackedStringArray("4.3")
boot_splash/bg_color=Color(0.12549, 0.156863, 0.219608, 1)
boot_splash/image="res://ui/carga.png"
boot_splash/fullsize=false
boot_splash/use_filter=false
config/icon="res://ui/icono.png"
config/windows_native_icon="res://ui/icono.ico"

[display]

window/size/viewport_width=240
window/size/viewport_height=160
window/size/window_width_override=960
window/size/window_height_override=640
window/size/window_width_override.web=0
window/size/window_height_override.web=0
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
